# =====================================================================
# CẤU HÌNH MÔI TRƯỜNG DEV (LAB / VIETTEL CLOUD DEV) (.env.dev)
# =====================================================================

# IMAGE DOCKER & PORT
IMAGE_NAME=hongdatchy/cloudcam-ai:latest
APP_PORT=8008

# 1. KAFKA BROKER & AUTH (Môi trường Dev)
KAFKA_BOOTSTRAP_SERVERS=100.120.108.85:9092
KAFKA_USER=admin
KAFKA_PASSWORD=Admin@123
KAFKA_FACE_TOPIC=ai_face_topic
KAFKA_FIRE_TOPIC=ai_fire_topic
KAFKA_GROUP_ID_FACE=face_recognition_group
KAFKA_GROUP_ID_FIRE=fire_detection_group

# 2. REDIS CACHE & COORDINATION (Môi trường Dev)
REDIS_HOST=192.168.100.2
REDIS_PORT=6379
REDIS_PASSWORD=

# 3. STREAM COORDINATOR (ĐIỀU PHỐI TẢI)
COORDINATOR_PORT=8200
COORDINATOR_URL=http://coordinator:8200
COORDINATOR_NODES=http://extractor_node_1:8101,http://extractor_node_2:8102
HEALTHCHECK_INTERVAL=10
HEALTHCHECK_TIMEOUT=3

# 4. EXTRACTOR NODES (CẮT FRAME CAMERA)
EXTRACTOR_NODE_1_PORT=8101
EXTRACTOR_NODE_2_PORT=8102
EXTRACTOR_MAX_WORKERS=50

# 5. AI CONSUMERS (ĐA LUỒNG XỬ LÝ MODEL AI)
AI_FACE_MAX_WORKERS=4
AI_FIRE_MAX_WORKERS=4
